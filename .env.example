# Segredos do ORION — copia para .env e preenche (nunca commits o .env)
# Chave da API do Langflow (opcional)
ORION_LANGFLOW_API_KEY=
# Token de longa duração do Home Assistant (opcional)
ORION_HA_TOKEN=
# Token de acesso ao painel web fora de localhost (obrigatório se expuser a rede)
ORION_WEB_TOKEN=
